APP_NAME=yinghai-go-api-server
APP_ENV=development
APP_PORT=8081
API_PREFIX=/api/v2

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yinghai_v2_dev
MYSQL_USER=yinghai
MYSQL_PASSWORD=yinghai_dev_password
MYSQL_CHARSET=utf8mb4
MYSQL_PARSE_TIME=true
MYSQL_LOC=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=yinghai_redis_password
REDIS_DB=0

JWT_SECRET=change_me_for_local_dev
JWT_ISSUER=yinghai-v2
JWT_EXPIRES_MINUTES=120

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_MOCK=true

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
MOCK_PAYMENT_ENABLED=true
MOCK_PAYMENT_SECRET=change_me_mock_payment_secret

LOG_LEVEL=debug
